---
import { contact } from '../lib/data';
import { inline, type Block } from '../lib/md';

// ---- the words come from content/contact.md; this file only lays them out ----
const secs = contact.secs;
const text = (bs: Block[] = []) => bs.filter((b): b is Extract<Block, { t: 'p' }> => b.t === 'p').map((b) => b.text);

// the closing sentence: one line of the paragraph = one line on the page (the breaks and the **bold** / _italic_ marks are written in the content)
const closing = text(secs['closing'])[0] ?? '';
const lines = closing.split('\n');
const closingPlain = closing.replace(/\n/g, ' ').replace(/\*\*|_/g, '');

const contactLabel = text(secs['contact'])[0] ?? '';
const contactItems = (secs['contact'] ?? []).filter((b): b is Extract<Block, { t: 'ul' }> => b.t === 'ul').flatMap((b) => b.items);

const icons: Record<string, string> = {
  mail: '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 7l8.5 6.2L20.5 7"/></svg>',
  phone: '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 3.5h3l1.6 4-2 1.3a11 11 0 005.1 5.1l1.3-2 4 1.6v3a2 2 0 01-2.2 2A15.5 15.5 0 013.5 5.7 2 2 0 015.5 3.5z"/></svg>',
};
const linkContact = (t: string) => inline(t).replace(/[\w.+-]+@[\w-]+\.[\w.]+/, (m) => `<a href="mailto:${m}">${m}</a>`).replace(/\+\d[\d ]{7,}\d/, (m) => `<a href="tel:${m.replace(/ /g, '')}">${m}</a>`);
// "Gmail: ..." / "Phone: ..." -> a fine line symbol instead of the word (the word stays for screen readers)
const contactRow = (t: string) => {
  const m = /^([^:]+):\s*(.*)$/.exec(t);
  const kind = m && /mail/i.test(m[1]) ? 'mail' : m && /phone|tel/i.test(m[1]) ? 'phone' : '';
  if (!m || !kind) return linkContact(t);
  return `<span class="ci">${icons[kind]}</span><span class="sr-only">${m[1]}: </span>${linkContact(m[2])}`;
};
---
<article id="contact" class="ctp" aria-labelledby="ct-title">
  <div class="ct-in wrap">
    <h1 id="ct-title" class="ct-line" aria-label={closingPlain}>
      {lines.map((l, i) => <span class={`ln ln${i + 1}`} aria-hidden="true" set:html={inline(l)} />)}
    </h1>
    <div class="ct-side">
      <p class="ct-label label">{contactLabel}</p>
      <ul class="ct-list">
        {contactItems.map((t) => <li set:html={contactRow(t)} />)}
      </ul>
    </div>
  </div>
  <!-- a corner of straw mat (chiếu cói) -->
  <img class="corner" src="/img/coi-corner.webp" alt="" width="800" height="800" aria-hidden="true" />
</article>

<style>
  .ctp { position: relative; background: var(--paper); color: var(--ink); overflow: hidden; min-height: calc(100svh - 7rem); display: grid; align-content: center; }
  .ct-in { position: relative; z-index: 1; display: grid; gap: clamp(2.5rem, 6vw, 4.5rem); padding: clamp(3rem, 6vw, 5rem) 0; }
  @media (max-width: 700px) { .ct-in { padding-bottom: 12rem; } }
  /* wide screens: the sentence on the left, the contact on the right (reads left to right) */
  @media (min-width: 900px) { .ct-in { grid-template-columns: 7fr 4fr; column-gap: clamp(2rem, 5vw, 5rem); align-items: center; } .ct-side { justify-self: start; } }

  /* the closing sentence: two sizes, one italic colour, and a plain line at the end */
  .ct-line { --big: clamp(2.6rem, 6.4vw, 5.8rem); font-weight: 300; line-height: 1.02; letter-spacing: -.03em; animation: fade 1.2s var(--ease) .1s both; }
  .ln { display: block; }
  .ln :global(strong) { font-weight: 300; }
  .ln :global(em) { font-style: italic; }
  .ln1, .ln4 { font-style: italic; font-size: clamp(1.2rem, 2.2vw, 1.8rem); color: var(--orange); letter-spacing: 0; }
  .ln2, .ln3 { font-size: var(--big); line-height: .98; }
  .ln3 { font-style: italic; color: var(--orange); }
  .ln4 :global(strong) { font-style: normal; font-size: calc(var(--big) * 1); letter-spacing: -.03em; color: var(--ink); margin-left: .2em; }
  .ln5, .ln6 { font-family: var(--sans); font-weight: 400; font-size: clamp(.95rem, 1.4vw, 1.15rem); letter-spacing: 0; line-height: 1.6; color: var(--ink); }
  .ln5 { margin-top: clamp(1.2rem, 2.6vw, 2rem); }
  .ln5 :global(strong), .ln6 :global(strong) { font-weight: 700; }

  .ct-side { animation: rise 1.2s var(--ease) .35s both; }
  .ct-label { color: var(--ink-soft); }
  .ct-list { display: grid; gap: .5rem; margin-top: .7rem; }
  .ct-list li { font-family: var(--display); font-size: clamp(1.35rem, 2.2vw, 1.9rem); line-height: 1.2; overflow-wrap: anywhere; }
  .ct-list :global(.ci) { display: inline-grid; place-items: center; width: 1.9em; height: 1.9em; margin-right: .55em; vertical-align: -.35em; border: 1px solid var(--hair); border-radius: 50%; font-size: .62em; }
  .ct-list :global(a) { text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .ct-list :global(a:hover) { color: var(--orange); }

  /* the corner of mat: a triangle bleeding off the bottom-right corner of the page */
  .corner { position: absolute; right: 0; bottom: 0; width: clamp(10rem, 30vw, 28rem); height: auto; clip-path: polygon(100% 0, 100% 100%, 0 100%); animation: corner 1.4s var(--ease) .3s both; pointer-events: none; }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes rise { from { opacity: 0; transform: translateY(.8rem); } to { opacity: 1; transform: none; } }
  @keyframes corner { from { opacity: 0; transform: translate(1.5rem, 1.5rem); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .ct-line, .ct-side, .corner { animation: none; } }
</style>

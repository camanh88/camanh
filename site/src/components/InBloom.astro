---
import Photo from './Photo.astro';
import { ch04 } from '../lib/data';
import { phrases } from '../lib/md';

const flor = ch04.ps(ch04.florTitle.toLowerCase());
const titleWords = ch04.title.split(' ');          // "In" / "bloom"
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<article id="in-bloom" class="om" aria-labelledby="om-title">

  <!-- OPENER: just the title; the letters of "bloom" open one after another -->
  <section class="bl" aria-labelledby="om-title">
    <div class="bl-in wrap">
      <h1 id="om-title" class="bl-title" aria-label={ch04.title}>
        <span class="bl-a" aria-hidden="true">{titleWords[0]}</span>
        <span class="bl-b" aria-hidden="true">{[...titleWords.slice(1).join(' ')].map((ch, i) => <span class="lt" style={`--i:${i}`}>{ch}</span>)}</span>
      </h1>
      <p class="bl-hint">{ch04.hint}</p>
      <a class="bl-cue label" href="#florist"><span>{ch04.florTitle}</span><i aria-hidden="true"></i></a>
    </div>
  </section>

  <!-- THE FLORIST IN ME: lots of photos and videos -->
  <section id="florist" class="flor" aria-labelledby="flor-title">
    <div class="f-head wrap">
      <h2 id="flor-title" class="f-title" >{ch04.florTitle}</h2>
      <p class="f-text" set:html={phrases(flor[0] ?? '')} />
    </div>

    <div class="f-spread">
      <!-- the layout follows Cam Anh's third mock-up (Oct 17): one tall lime block, photo and cut-outs on top, video tiles below, the F1 hero video at the end -->
      <div class="band" style="--ar: 352 / 1163.3">
        <div class="it blk lime" style="--l:27%;--t:0;--w:73%;--h:100%"></div>
        <div class="it" style="--l:0;--t:1.03%;--w:54%;--h:20.46%"><Photo id="f-box" sizes="(min-width: 900px) 50vw, 55vw" /></div>
        <div class="it cut" style="--l:46.3%;--t:14.94%;--w:51.7%;z-index:3"><Photo id="f-lily-cut" sizes="(min-width: 900px) 50vw, 55vw" /></div>
        <div class="it vid" style="--l:0;--t:29.79%;--w:61.4%;--h:23.55%"><video class="f-video" muted loop playsinline preload="none" poster={`${base}img/fv-bouquet-poster-960.webp`} data-hd={`${base}video/fv-bouquet-hd.mp4`} data-sd={`${base}video/fv-bouquet-sd.mp4`} aria-label="A large bouquet of blue hydrangeas, pink lilies and white flowers on a wooden cabinet beneath an orange painting."></video></div>
        <div class="it vid" style="--l:42%;--t:55.87%;--w:42.6%;--h:22.78%"><video class="f-video" muted loop playsinline preload="none" poster={`${base}img/fv-window-poster-960.webp`} data-hd={`${base}video/fv-window-hd.mp4`} data-sd={`${base}video/fv-window-sd.mp4`} aria-label="A woman in a pink top arranging flowers on a long counter by a window with a red flag outside."></video></div>
        <div class="it cut" style="--l:0;--t:61.23%;--w:34.7%;z-index:2"><Photo id="f-woman" sizes="(min-width: 900px) 50vw, 55vw" /></div>
        <div class="it vid" style="--l:0;--t:81.95%;--w:100%;--h:17.02%"><video class="f-video" muted loop playsinline preload="none" poster={`${base}img/f1-poster-1600.webp`} data-hd={`${base}video/f1-1080.mp4`} data-sd={`${base}video/f1-540.mp4`} aria-label="A woman in a red top, seen from behind, arranging a large bouquet of orange, pink and red flowers with berries on a wooden table."></video></div>
      </div>
    </div>
  </section>

</article>

<style>
  .om { --paper: #fff; --beige: #F7ECCD; --sage: var(--beige); background: #fff; --pad: clamp(1.25rem, 4vw, 4rem); overflow-x: clip; }
  .wrap { width: min(100% - 2 * var(--pad), 88rem); margin-inline: auto; }
  .label { font-family: var(--sans); }
  /* photo frame: the picture is already cropped to this ratio, cover only absorbs rounding */
  .pic { position: relative; width: 100%; aspect-ratio: var(--a); overflow: hidden; background: var(--mist); }
  .pic :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  :global(.ul) { text-decoration: underline; text-decoration-thickness: .08em; text-underline-offset: .22em; text-decoration-color: var(--orange); }
  .gnum { font-family: var(--display); font-weight: 300; font-size: clamp(5rem, 14vw, 12rem); line-height: .75; letter-spacing: -.04em; }

  /* ---------- opener: the title alone ---------- */
  .bl { background: var(--orange); color: var(--cream); }
  .bl-in { min-height: calc(100svh - 7rem); display: grid; align-content: center; justify-items: start; padding: clamp(3rem, 8vw, 6rem) 0; }
  .bl-title { font-weight: 300; line-height: .8; letter-spacing: -.05em; display: grid; }
  .bl-a { font-style: italic; font-size: clamp(2rem, 6vw, 5rem); color: var(--pink); letter-spacing: -.02em; padding-left: .12em; }
  .bl-b { font-size: clamp(5.6rem, 24vw, 21rem); margin-left: -.04em; white-space: nowrap; }
  .lt { display: inline-block; animation: lt 1.3s var(--ease) both; animation-delay: calc(.2s + var(--i) * 110ms); }
  @keyframes lt { from { opacity: 0; transform: translateY(.22em) scale(.86); letter-spacing: -.12em; } to { opacity: 1; transform: none; } }
  .bl-hint { font-family: var(--display); font-style: italic; font-size: clamp(1.25rem, 2.2vw, 1.8rem); line-height: 1.35; color: var(--cream); margin-top: clamp(1.6rem, 4vw, 3rem); max-width: 20em; animation: rise 1.1s var(--ease) .9s both; }
  .bl-cue { display: inline-flex; align-items: center; gap: .9rem; margin-top: clamp(2rem, 5vw, 3.5rem); color: var(--cream); text-decoration: none; animation: rise 1.1s var(--ease) 1.1s both; }
  .bl-cue i { width: 3rem; height: 1px; background: currentColor; transition: width .4s var(--ease); }
  .bl-cue:hover i { width: 5rem; }
  @keyframes rise { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .lt, .bl-hint, .bl-cue { animation: none; } .bl-cue i { transition: none; } }

  /* ---------- florist ---------- */
  .flor { background: var(--sage); color: var(--ink); padding: var(--section) 0 0; }
  .f-head { display: grid; gap: 1.2rem; }
  .flor .gnum { color: var(--moss); }
  .f-title { font-size: clamp(3rem, 11vw, 11rem); line-height: .86; letter-spacing: -.05em; font-weight: 300; max-width: 8ch; }
  .f-title { font-style: italic; color: var(--orange); }
  .f-text { font-family: var(--display); font-size: clamp(1.5rem, 2.6vw, 2.4rem); line-height: 1.18; max-width: 20em; }
  .f-spread { --fp: clamp(.5rem, 1.2vw, 1.1rem); --gap: clamp(1rem, 2.5vw, 2.5rem); background: var(--paper); margin-top: clamp(2.5rem, 6vw, 5rem); padding: var(--gap) 0; }
  /* equal spacing (Cam Anh chose option A): the lime overhangs the first photo and the F1 video by the same amount (12/1163 of the block),
     and the white gaps above and below the block are both var(--gap) */
  .f-spread > * { width: calc(100% - 2 * var(--fp)); max-width: 100rem; margin-inline: auto; }
  .f-video { display: block; width: 100%; height: 100%; object-fit: cover; background: var(--orange); }
  .band { position: relative; aspect-ratio: var(--ar); }
  .it { position: absolute; left: var(--l); top: var(--t); width: var(--w); height: var(--h, auto); overflow: hidden; background: var(--mist); }
  .it :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .it.cut { background: none; overflow: visible; }
  .it.cut :global(img) { height: auto; object-fit: contain; }
  .it.blk { background: var(--sage); } .it.pink { background: var(--orange); } .it.vid { background: var(--orange); }
  @media (min-width: 900px) {
    .f-head { grid-template-columns: repeat(12, 1fr); column-gap: 2rem; align-items: start; }
    .f-head .gnum { grid-column: 1 / 3; grid-row: 1 / 3; }
    .f-title { grid-column: 1 / 9; grid-row: 1; }
    .f-text { grid-column: 8 / 13; grid-row: 2; }
  }
</style>

<script>
  // Florist videos (hero + three tiles): each loads only when it comes into view (large copy, or the light copy on phones),
  // plays muted and looped, pauses when scrolled away. With "reduce motion" they stay on the poster and show controls instead.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phone = () => matchMedia('(max-width: 700px)').matches;
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting) {
      if (!v.getAttribute('src')) v.src = (phone() ? v.dataset.sd : v.dataset.hd) ?? '';
      if (!reduce) v.play().catch(() => {});
    } else v.pause();
  }), { rootMargin: '200px 0px', threshold: 0.15 });
  document.querySelectorAll<HTMLVideoElement>('.f-video').forEach((v) => {
    if (reduce) { v.controls = true; v.removeAttribute('loop'); }
    io.observe(v);
  });
</script>
